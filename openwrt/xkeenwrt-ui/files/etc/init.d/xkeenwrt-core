#!/bin/sh /etc/rc.common
# Started only with the current validated generation's launch nonce.
USE_PROCD=1
start_service() {
    [ -n "$1" ] || return 1
    [ -f /tmp/xkeenwrt/runtime/active/config.yaml ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/xkeenwrt-ui core-run "$1"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
